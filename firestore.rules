rules_version = '2';
// users/{uid}: private onboarding profile. uid immutable; email mirrors verified Auth; names <=80;
// selectedRole is ONLY a navigation preference, never an academy authorization.
// birthDateMillis nullable only for ADM/DT or imported users with a signed role.
// isActive is server-managed after creation. timestamps are server timestamps.
// All business collections remain closed until their scoped ACLs are implemented.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function importedRole(role) {
      return request.auth.token.get('app_role', '') == role ||
        request.auth.token.get('role', '') == role;
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'names', 'lastNames', 'selectedRole',
          'birthDateMillis', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'names', 'lastNames', 'selectedRole',
          'birthDateMillis', 'isActive', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == uid && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 254 &&
        data.email == request.auth.token.email &&
        data.names is string && data.names.size() > 0 && data.names.size() <= 80 &&
        data.lastNames is string && data.lastNames.size() <= 80 &&
        (data.lastNames.size() > 0 || importedRole(data.selectedRole)) &&
        data.selectedRole in ['ADM', 'DT', 'JUG', 'PAD'] &&
        (data.birthDateMillis is int &&
          data.birthDateMillis >= -2208988800000 &&
          data.birthDateMillis <= request.time.toMillis() ||
          data.birthDateMillis == null &&
            (data.selectedRole in ['ADM', 'DT'] || importedRole(data.selectedRole))) &&
        data.isActive is bool && data.isActive == true &&
        data.createdAt is timestamp && data.createdAt == request.time &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfile(request.resource.data, uid);
      // Only copy the verified Firebase Auth email; no role/identity/activation changes.
      allow update: if isOwner(uid) && resource.data.isActive == true &&
        request.auth.token.get('email_verified', false) == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 254 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function activeUser() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function trustedEditor() {
      return activeUser() && (importedRole('ADM') || importedRole('DT'));
    }
    function canView(m) { return activeUser() && request.auth.uid in m.viewerUids; }
    function canOperate(m) { return trustedEditor() && request.auth.uid in m.operatorUids; }
    function eventTypes() {
      return ['period_start', 'period_end', 'goal', 'goal_kick', 'throw_in', 'corner_kick',
        'foul', 'yellow_card', 'red_card', 'penalty', 'offside', 'substitution'];
    }
    function matchData(mid) { return get(/databases/$(database)/documents/matches/$(mid)).data; }
    function validCatalog(d) {
      return d.keys().hasOnly(['ownerUid', 'category', 'enabled', 'version', 'updatedAt']) &&
        d.ownerUid == request.auth.uid && d.category is string && d.category.size() > 0 && d.category.size() <= 80 &&
        d.enabled is list && d.enabled.size() <= 12 && d.enabled.hasOnly(eventTypes()) &&
        d.enabled.hasAll(['period_start', 'period_end']) && d.version is int &&
        d.updatedAt == request.time;
    }
    match /clockProbes/{uid} {
      allow get: if isOwner(uid) && activeUser();
      allow create, update: if isOwner(uid) && activeUser() &&
        request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow list, delete: if false;
    }
    match /matchCatalogs/{id} {
      // Public taxonomy only. No personal information belongs in catalog documents.
      allow read: if activeUser();
      allow create: if trustedEditor() && validCatalog(request.resource.data) && request.resource.data.version == 1;
      allow update: if trustedEditor() && resource.data.ownerUid == request.auth.uid &&
        validCatalog(request.resource.data) && request.resource.data.category == resource.data.category &&
        request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    function validMatchCreate(d) {
      return d.keys().hasOnly(['ownerUid', 'home', 'away', 'category', 'catalogId', 'periodMinutes',
        'viewerUids', 'operatorUids', 'phase', 'accumulatedSeconds', 'startedAt', 'clockVersion',
        'lastClockEvent', 'createdAt', 'updatedAt']) &&
        d.ownerUid == request.auth.uid &&
        d.home is string && d.home.size() > 0 && d.home.size() <= 80 &&
        d.away is string && d.away.size() > 0 && d.away.size() <= 80 &&
        d.category is string && d.category.size() > 0 && d.category.size() <= 80 &&
        d.catalogId is string &&
        getAfter(/databases/$(database)/documents/matchCatalogs/$(d.catalogId)).data.ownerUid == d.ownerUid &&
        getAfter(/databases/$(database)/documents/matchCatalogs/$(d.catalogId)).data.category == d.category &&
        d.periodMinutes is int && d.periodMinutes >= 5 && d.periodMinutes <= 60 &&
        d.viewerUids is list && d.viewerUids.size() <= 100 &&
        d.operatorUids is list && d.operatorUids.size() <= 10 &&
        request.auth.uid in d.operatorUids && d.viewerUids.hasAll(d.operatorUids) &&
        d.phase == 'READY' && d.accumulatedSeconds == 0 && d.startedAt == null &&
        d.clockVersion == 0 && d.lastClockEvent == '' &&
        d.createdAt == request.time && d.updatedAt == request.time;
    }
    function running(phase) { return phase in ['FIRST', 'SECOND']; }
    function validClockChange(mid, old, d) {
      let wasRunning = running(old.phase);
      let isRunning = running(d.phase);
      let elapsed = old.accumulatedSeconds +
        (wasRunning ? (request.time.toMillis() - old.startedAt.toMillis()) / 1000 : 0);
      // A forgotten running match reaches the supported four-hour limit; it can still close.
      let expectedElapsed = elapsed > 14400 ? 14400 : elapsed;
      let boundary = old.phase in ['READY', 'HALF_TIME'] ||
        d.phase in ['HALF_TIME', 'FINISHED'];
      return d.diff(old).affectedKeys().hasOnly(['phase', 'accumulatedSeconds', 'startedAt',
          'clockVersion', 'lastClockEvent', 'updatedAt']) &&
        d.clockVersion == old.clockVersion + 1 && d.updatedAt == request.time &&
        d.accumulatedSeconds is int && d.accumulatedSeconds >= old.accumulatedSeconds &&
        d.accumulatedSeconds <= 14400 &&
        (wasRunning ? d.accumulatedSeconds >= expectedElapsed - 5 && d.accumulatedSeconds <= expectedElapsed + 5 :
          d.accumulatedSeconds == old.accumulatedSeconds) &&
        (isRunning ? d.startedAt == request.time : d.startedAt == null) &&
        ((old.phase == 'READY' && d.phase == 'FIRST') ||
         (old.phase == 'FIRST' && d.phase in ['PAUSED_FIRST', 'HALF_TIME']) ||
         (old.phase == 'PAUSED_FIRST' && d.phase in ['FIRST', 'HALF_TIME']) ||
         (old.phase == 'HALF_TIME' && d.phase == 'SECOND') ||
         (old.phase == 'SECOND' && d.phase in ['PAUSED_SECOND', 'FINISHED']) ||
         (old.phase == 'PAUSED_SECOND' && d.phase in ['SECOND', 'FINISHED'])) &&
        (boundary ? d.lastClockEvent is string && d.lastClockEvent.size() > 0 &&
          getAfter(/databases/$(database)/documents/matches/$(mid)/events/$(d.lastClockEvent)).data.typeId ==
            (isRunning ? 'period_start' : 'period_end') &&
          getAfter(/databases/$(database)/documents/matches/$(mid)/events/$(d.lastClockEvent)).data.seconds == d.accumulatedSeconds :
          d.lastClockEvent == '');
    }
    function validEvent(d, eid) {
      return d.keys().hasOnly(['eventId', 'operationId', 'version', 'typeId', 'seconds', 'side',
        'player', 'otherPlayer', 'detail', 'observations', 'voided', 'actorUid', 'reason',
        'recordedAt', 'catalogVersion', 'capturedAtMillis']) &&
        d.eventId == eid && d.operationId is string && d.operationId.matches('[a-zA-Z0-9_-]{1,128}') &&
        d.version is int && d.version > 0 && d.typeId in eventTypes() &&
        d.seconds is int && d.seconds >= 0 && d.seconds <= 14400 &&
        d.player is string && d.player.size() <= 100 &&
        d.otherPlayer is string && d.otherPlayer.size() <= 100 &&
        d.detail is string && d.detail.size() <= 200 &&
        d.observations is string && d.observations.size() <= 2000 &&
        d.voided is bool && d.actorUid == request.auth.uid &&
        d.reason is string && d.reason.size() <= 500 &&
        d.recordedAt == request.time && d.catalogVersion is int &&
        d.capturedAtMillis is int &&
        (d.typeId in ['period_start', 'period_end'] ? d.side == '' :
          d.side in ['HOME', 'AWAY']) &&
        (!(d.typeId in ['goal', 'yellow_card', 'red_card']) || d.detail.size() > 0) &&
        (d.typeId != 'substitution' || d.player == '' || d.otherPlayer == '' || d.player != d.otherPlayer);
    }
    function hasNewHistory(mid, eid, d) {
      return !exists(/databases/$(database)/documents/matches/$(mid)/events/$(eid)/history/$(d.operationId)) &&
        getAfter(/databases/$(database)/documents/matches/$(mid)/events/$(eid)/history/$(d.operationId)).data == d;
    }
    function validNewEvent(mid, eid, d) {
      let m = matchData(mid);
      let afterMatch = getAfter(/databases/$(database)/documents/matches/$(mid)).data;
      let catalog = get(/databases/$(database)/documents/matchCatalogs/$(m.catalogId)).data;
      return d.version == 1 && d.voided == false && d.reason == '' &&
        (d.typeId in ['period_start', 'period_end'] ?
          afterMatch.clockVersion == m.clockVersion + 1 && afterMatch.lastClockEvent == eid &&
          d.seconds == afterMatch.accumulatedSeconds && d.catalogVersion == 0 :
          m.phase != 'READY' && d.typeId in catalog.enabled && d.catalogVersion == catalog.version);
    }
    match /matches/{mid} {
      allow get: if canView(resource.data) || (trustedEditor() && !exists(/databases/$(database)/documents/matches/$(mid)));
      allow list: if canView(resource.data);
      allow create: if trustedEditor() && validMatchCreate(request.resource.data);
      allow update: if canOperate(resource.data) && validClockChange(mid, resource.data, request.resource.data);
      allow delete: if false;
      match /events/{eid} {
        allow read: if canView(matchData(mid));
        allow create: if canOperate(matchData(mid)) && validEvent(request.resource.data, eid) &&
          validNewEvent(mid, eid, request.resource.data) && hasNewHistory(mid, eid, request.resource.data);
        allow update: if canOperate(matchData(mid)) && validEvent(request.resource.data, eid) &&
          !(resource.data.typeId in ['period_start', 'period_end']) &&
          !(request.resource.data.typeId in ['period_start', 'period_end']) &&
          resource.data.voided == false && request.resource.data.version == resource.data.version + 1 &&
          request.resource.data.reason.size() > 0 && hasNewHistory(mid, eid, request.resource.data);
        allow delete: if false;
        match /history/{operation} {
          allow read: if canView(matchData(mid));
          allow create: if canOperate(matchData(mid)) && request.resource.data.operationId == operation &&
            request.resource.data == getAfter(/databases/$(database)/documents/matches/$(mid)/events/$(eid)).data;
          allow update, delete: if false;
        }
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
